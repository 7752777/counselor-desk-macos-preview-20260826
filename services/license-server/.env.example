# Copy to deployment-managed configuration. Do not commit real values.
CWB_LICENSE_ENV=production
CWB_LICENSE_DATABASE_URL=postgresql://license_app:change-me@db.example.invalid:5432/counselor_license
CWB_LICENSE_DATABASE_SSL=true
CWB_LICENSE_CORS_ORIGINS=https://license.example.invalid,https://app.example.invalid
# Required for single-file HTML activation. It only permits Origin: null on the three public license activation routes; keep it false if the service is never used by local HTML.
CWB_LICENSE_ALLOW_FILE_ORIGIN=true
CWB_LICENSE_REQUIRE_HTTPS=true
CWB_LICENSE_TRUST_PROXY=true
CWB_LICENSE_HOST=127.0.0.1
CWB_LICENSE_PORT=8787
CWB_LICENSE_DB_POOL_MAX=10
CWB_ORDER_ACCESS_SECRET=inject-from-secret-manager
CWB_LICENSE_SIGNER_MODULE=/run/secrets/counselor-license-kms-signer.cjs
# Optional deployment-owned module exporting { campaigns: [{ campaign_id, plan, code_hash, status }] }.
# Hashes only; never put a plaintext CWB-REDEEM-1 code here.
# CWB_LICENSE_REDEMPTION_MODULE=/run/secrets/counselor-license-redemptions.cjs
# Optional adapters, supplied outside this repository.
# CWB_LICENSE_MAILER_MODULE=/run/secrets/counselor-license-mailer.cjs
# CWB_LICENSE_PAYMENT_MODULE=/run/secrets/counselor-license-payment.cjs
# CWB_LICENSE_WEBHOOK_SECRET=inject-from-secret-manager
# CWB_TELEMETRY_SALT=inject-from-secret-manager
# Never set CWB_LICENSE_ADMIN_TOKEN in production. Create a hashed key once with:
# pnpm --dir services/license-server admin:key
